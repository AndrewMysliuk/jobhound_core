# App Postgres DSN. Required for DB use; no default.
JOBHOUND_DATABASE_URL=

# Migrate DSN override. Default: falls back to JOBHOUND_DATABASE_URL.
JOBHOUND_MIGRATE_DATABASE_URL=

# Pool max open. Default: 25.
JOBHOUND_DB_MAX_OPEN_CONNS=25

# Pool max idle. Default: 5.
JOBHOUND_DB_MAX_IDLE_CONNS=5

# Conn max lifetime, seconds. Default: 3600.
JOBHOUND_DB_CONN_MAX_LIFETIME_SEC=3600

# cmd/api address. Default: 127.0.0.1:3000.
JOBHOUND_API_LISTEN=127.0.0.1:3000

# Browser origins, comma-separated. Default when unset: http://localhost:5173,http://localhost:3002. Set empty to allow none.
JOBHOUND_API_CORS_ORIGINS=http://localhost:5173,http://localhost:3002

# Ingest lock Redis. Default: empty (ingest fails closed without it).
JOBHOUND_REDIS_URL=

# Bypass cooldown. Default: false.
JOBHOUND_INGEST_EXPLICIT_REFRESH=false

# Lock TTL, seconds. Default: 600.
JOBHOUND_INGEST_LOCK_TTL_SEC=600

# Cooldown TTL, seconds. Default: 3600.
JOBHOUND_INGEST_COOLDOWN_TTL_SEC=3600

# zerolog level. Default: info.
JOBHOUND_LOG_LEVEL=info

# console or json. Default: console.
JOBHOUND_LOG_FORMAT=console

# Dir with countries.json. Default: empty (data relative to the process).
JOBHOUND_DATA_DIR=

# cmd/agent debug listen. Default: empty (debug HTTP off).
JOBHOUND_DEBUG_HTTP_ADDR=

# Skip Himalayas. Default: false.
JOBHOUND_COLLECTOR_HIMALAYAS_DISABLED=false

# Page cap. 0 collector default, -1 unlimited. Default: 0.
JOBHOUND_COLLECTOR_HIMALAYAS_MAX_PAGES=0

# Search query. Default: empty (full feed).
JOBHOUND_COLLECTOR_HIMALAYAS_SEARCH=

# Built In delay, milliseconds. Default: 1000.
JOBHOUND_COLLECTOR_BUILTIN_INTER_REQUEST_DELAY_MS=1000

# Built In via rod. Default: true. 0 / false / no / off forces net/http.
JOBHOUND_COLLECTOR_BUILTIN_USE_BROWSER=true

# Rod on/off. Default: true. 0 / false / no / off disables.
JOBHOUND_BROWSER_ENABLED=true

# Chromium binary. Default: empty.
JOBHOUND_BROWSER_BIN=

# Chromium profile dir. Default: empty.
JOBHOUND_BROWSER_USER_DATA_DIR=

# Navigation timeout, milliseconds. Default: 120000.
JOBHOUND_BROWSER_NAV_TIMEOUT_MS=120000

# Chromium --no-sandbox. Default: false.
JOBHOUND_BROWSER_NO_SANDBOX=false

# HTTP CONNECT proxy for euremotejobs.com only. Empty dials directly (correct on the host, which has IPv6).
# Docker Compose sets http://host.docker.internal:18080; make docker-up listens there via cmd/ipv6proxy.
JOBHOUND_EUROPE_REMOTELY_PROXY=

# Temporal frontend. Required for worker and API workflow start; no default.
JOBHOUND_TEMPORAL_ADDRESS=

# Namespace. Default: default.
JOBHOUND_TEMPORAL_NAMESPACE=default

# Task queue. Default: jobhound.
JOBHOUND_TEMPORAL_TASK_QUEUE=jobhound

# Worker creates the weekly schedule. Default: true.
JOBHOUND_JOB_RETENTION_SCHEDULE_UPSERT=true

# Profile YAML directory. Empty → config/profiles (relative to the process).
JOBHOUND_PROFILES_DIR=

# Retention window, days. Default: 30. Must be a positive integer.
JOBHOUND_JOB_RETENTION_DAYS=30
