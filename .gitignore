# Local secrets and env — never commit
.env
.env.*
!.env.example

# Local CV material for search calibration
/config/cv/

# Local company lists (applied + target Excels) — not indexed
/config/companies/

# Go
/bin/
/dist/
*.exe
*.test
*.out
coverage.out
vendor/

# SQLite / runtime data
*.db
*.sqlite
*.sqlite3
.data/

# Local Postgres dumps (make db-dump) — keep dir, ignore contents
/data/local/*
!/data/local/.gitkeep

# Session material (paths may be overridden in .env)
cookies.txt

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store
