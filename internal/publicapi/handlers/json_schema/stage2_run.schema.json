{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["rules"],
  "properties": {
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/stage2Rule" }
    }
  },
  "$defs": {
    "stage2Rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "field", "op", "values", "action"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "field": {
          "type": "string",
          "enum": [
            "title",
            "body",
            "title_body",
            "listing",
            "countries_allowed",
            "position"
          ]
        },
        "op": { "type": "string", "enum": ["any", "excludes", "phrase"] },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "action": {
          "type": "string",
          "enum": ["reject", "flag", "boost", "penalty"]
        },
        "weight": { "type": "integer" },
        "when": { "type": "string", "enum": ["explicit", "always"] },
        "negation_window": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "action": { "const": "boost" } },
            "required": ["action"]
          },
          "then": {
            "required": ["weight"],
            "properties": { "weight": { "type": "integer", "exclusiveMinimum": 0 } }
          }
        },
        {
          "if": {
            "properties": { "action": { "const": "penalty" } },
            "required": ["action"]
          },
          "then": {
            "required": ["weight"],
            "properties": { "weight": { "type": "integer", "exclusiveMaximum": 0 } }
          }
        },
        {
          "if": {
            "properties": { "action": { "enum": ["reject", "flag"] } },
            "required": ["action"]
          },
          "then": { "properties": { "weight": false } }
        },
        {
          "if": {
            "properties": { "field": { "const": "countries_allowed" } },
            "required": ["field"]
          },
          "then": { "properties": { "op": { "enum": ["any", "excludes"] } } }
        },
        {
          "if": {
            "properties": { "field": { "const": "position" } },
            "required": ["field"]
          },
          "then": { "properties": { "op": { "const": "any" } } }
        },
        {
          "if": {
            "properties": {
              "field": { "enum": ["title", "body", "title_body", "listing"] }
            },
            "required": ["field"]
          },
          "then": { "properties": { "op": { "const": "phrase" } } }
        },
        {
          "if": {
            "not": {
              "properties": { "op": { "const": "phrase" } },
              "required": ["op"]
            }
          },
          "then": { "properties": { "negation_window": false } }
        }
      ]
    }
  }
}
